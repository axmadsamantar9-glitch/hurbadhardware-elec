# ---------------------------------------------------------------------------
# Database (U2)
# Managed PostgreSQL with connection pooling (Neon or Supabase).
# DATABASE_URL uses the pooled connection; DIRECT_URL bypasses the pooler for
# migrations, which PgBouncer cannot run in transaction mode.
# ---------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------------
# Authentication (U3)
# AUTH_SECRET: generate with `npx auth secret`
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Media storage and delivery (U8 / U17 / U21)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# ---------------------------------------------------------------------------
# Payments — WaafiPay: EVC Plus + card rail, charged in USD (U12)
# NOTE: the production base URL is contested between the official docs
# (api.waafipay.net) and a widely-cited community guide (api.waafipay.com).
# Confirm with the account manager before go-live.
# Sandbox: https://sandbox.waafipay.com/asm
# ---------------------------------------------------------------------------
WAAFIPAY_BASE_URL=
WAAFIPAY_MERCHANT_UID=
WAAFIPAY_API_USER_ID=
WAAFIPAY_API_KEY=
WAAFIPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Payments — eDahab, charged in USD (U12)
# No documented sandbox: expect to test against live funds.
# Base URL has a doubled path segment: https://edahab.net/api/api/
# ---------------------------------------------------------------------------
EDAHAB_BASE_URL=
EDAHAB_API_KEY=
EDAHAB_API_SECRET=
EDAHAB_AGENT_CODE=

# ---------------------------------------------------------------------------
# Payments — Paystack: M-Pesa Kenya, charged in integer KES (U12)
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Currency conversion (U22)
# FX_SPREAD_PCT absorbs intra-hour rate drift, e.g. 1.5 for 1.5%.
# ---------------------------------------------------------------------------
FX_PROVIDER_API_KEY=
FX_PROVIDER_BASE_URL=
FX_SPREAD_PCT=1.5

# ---------------------------------------------------------------------------
# Scheduled jobs (U22 / U23)
# Shared bearer secret protecting the cron routes from external invocation.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API (U16)
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Transactional email (U15)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOW_STOCK_THRESHOLD=5
