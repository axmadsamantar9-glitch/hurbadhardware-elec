# ---------------------------------------------------------------------------
# Database (U2)
# Managed PostgreSQL with connection pooling (Neon or Supabase).
#
# On Supabase specifically, DATABASE_URL (the runtime connection PrismaClient
# uses on every request) MUST point at the Supavisor Transaction pooler —
# port 6543, with ?pgbouncer=true appended — not the Session pooler (5432).
# Vercel serverless functions open one new short-lived connection per
# invocation; the Session pooler is sized for a small number of long-lived
# connections (a persistent server process) and is the wrong mode for that
# access pattern. DIRECT_URL (used only by `prisma migrate`/`prisma db
# execute`, never by the running app) should stay on the Session pooler or
# true direct connection (5432), since migrations need a single stable
# session, not pooling.
#
# connection_limit=1 caps Prisma's own internal pool to a single connection.
# Reproduced locally: a fresh PrismaClient always connects, but a PrismaClient
# instance that stays alive across many requests (exactly what a warm Vercel
# Lambda reuses) can have Supavisor silently drop one of its ~5 default
# pooled connections after an idle period; Prisma's engine doesn't detect
# that and every subsequent query on that instance fails with "Can't reach
# database server" until the process restarts, even though the database is
# up and a brand-new connection to the same host:port succeeds immediately.
# Limiting the pool to 1 connection removes the multi-connection desync that
# triggers this.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:6543/database?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://user:password@host:5432/database

# ---------------------------------------------------------------------------
# Authentication (U3)
# AUTH_SECRET: generate with `npx auth secret` (required)
# AUTH_URL: fully-qualified site URL (e.g., https://example.com)
# GOOGLE_CLIENT_ID/SECRET: optional OAuth providers
# SEED_ADMIN_PASSWORD: override default admin password (development only)
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# Media storage and delivery (U8 / U17 / U21)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# ---------------------------------------------------------------------------
# Payments — WaafiPay: EVC Plus + card rail, charged in USD (U12)
# NOTE: the production base URL is contested between the official docs
# (api.waafipay.net) and a widely-cited community guide (api.waafipay.com).
# Confirm with the account manager before go-live.
# Sandbox: https://sandbox.waafipay.com/asm
# ---------------------------------------------------------------------------
WAAFIPAY_BASE_URL=
WAAFIPAY_MERCHANT_UID=
WAAFIPAY_API_USER_ID=
WAAFIPAY_API_KEY=
WAAFIPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Payments — eDahab, charged in USD (U12)
# No documented sandbox: expect to test against live funds.
# Base URL has a doubled path segment: https://edahab.net/api/api/
# ---------------------------------------------------------------------------
EDAHAB_BASE_URL=
EDAHAB_API_KEY=
EDAHAB_API_SECRET=
EDAHAB_AGENT_CODE=

# ---------------------------------------------------------------------------
# Payments — Paystack: M-Pesa Kenya, charged in integer KES (U12)
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Currency conversion (U22)
# FX_SPREAD_PCT absorbs intra-hour rate drift, e.g. 1.5 for 1.5%.
# ---------------------------------------------------------------------------
FX_PROVIDER_API_KEY=
FX_PROVIDER_BASE_URL=
FX_SPREAD_PCT=1.5

# ---------------------------------------------------------------------------
# Scheduled jobs (U22 / U23)
# Shared bearer secret protecting the cron routes from external invocation.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API (U16)
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Transactional email (U15)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOW_STOCK_THRESHOLD=5
