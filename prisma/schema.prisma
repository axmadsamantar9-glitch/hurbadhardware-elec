// Hurbad Hardware — full data model (U2).
//
// Conventions:
//   * Model and field names are camelCase/PascalCase for the Prisma Client;
//     `@map` / `@@map` keep the underlying Postgres identifiers snake_case.
//   * Money is always `Decimal` with an explicit precision/scale — never Float.
//     USD amounts use Decimal(10,2); charge amounts allow Decimal(12,2) because
//     KES totals are ~130x the USD figure. FX rates use Decimal(14,6).
//   * `Product.searchVector` is a Postgres GENERATED tsvector column that Prisma
//     cannot express. It is declared here as `Unsupported` so the client ignores
//     it; the real column definition and its GIN index live in
//     prisma/migrations/manual/001_search_vector.sql and must be folded into the
//     first real migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN

  @@map("role")
}

enum Locale {
  en
  so

  @@map("locale")
}

enum CountryCode {
  SO
  KE
  ET

  @@map("country_code")
}

enum CouponType {
  PERCENT
  FIXED

  @@map("coupon_type")
}

enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum Currency {
  USD
  KES

  @@map("currency")
}

enum PaymentGateway {
  WAAFIPAY
  EDAHAB
  PAYSTACK

  @@map("payment_gateway")
}

enum PaymentMethod {
  EVC_PLUS
  EDAHAB
  CARD
  MPESA

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED

  @@map("payment_status")
}

enum FxBase {
  USD

  @@map("fx_base")
}

enum FxQuote {
  KES

  @@map("fx_quote")
}

/// Fixed taxonomy of compatibility facts a product can carry (PRD §5.2).
/// Unlike ProductSpec's free-text keyEn/keySo (which are deliberately
/// open-ended and category-specific per HUB-27's loose-coupling rule), these
/// five kinds are named directly by the PRD itself and are not admin-
/// invented, so an enum is the right tool here rather than a free string.
enum CompatibilityType {
  DEVICE
  CONNECTOR
  OS_SUPPORT
  POWER
  CONSUMABLE

  @@map("compatibility_type")
}

// ---------------------------------------------------------------------------
// Identity — application user plus the three models @auth/prisma-adapter
// requires (Account, Session, VerificationToken).
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  // Optional because a customer may register with a phone number only, and
  // because Auth.js `AdapterUser` tolerates a null email.
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  phone         String?   @unique
  name          String?
  passwordHash  String?   @map("password_hash")
  role          Role      @default(CUSTOMER)
  country       String?
  locale        Locale    @default(en)
  googleId      String?   @unique @map("google_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  accounts         Account[]
  sessions         Session[]
  addresses        Address[]
  reviews          Review[]
  carts            Cart[]
  wishlists        Wishlist[]
  orders           Order[]
  whatsappSessions WhatsappSession[]
  inventoryLogs    InventoryLog[]
  auditLogs        AuditLog[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

/// Auth.js adapter model. The snake_case OAuth token fields are named exactly
/// as `AdapterAccount` sends them — do not rename them to camelCase.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Auth.js adapter model. Only used when the database session strategy is on.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Auth.js adapter model. Intentionally has no `id` column: the adapter strips
/// one if present, and the composite unique satisfies Prisma's key requirement.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Address {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  fullName     String      @map("full_name")
  phone        String
  addressLine1 String      @map("address_line1")
  addressLine2 String?     @map("address_line2")
  city         String
  state        String?
  country      CountryCode
  isDefault    Boolean     @default(false) @map("is_default")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id        String  @id @default(cuid())
  nameEn    String  @map("name_en")
  nameSo    String  @map("name_so")
  slug      String  @unique
  parentId  String? @map("parent_id")
  imageUrl  String? @map("image_url")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  parent           Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]        @relation("CategoryHierarchy")
  products         Product[]
  specTemplateKeys SpecTemplateKey[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

/// Per-category ordered set of bilingual specification keys (HUB-27). Purely
/// informational for the admin product-edit form ("here are the keys this
/// category usually needs, and which ones are typically mandatory") — it does
/// NOT constrain what ProductSpec rows a product can have. See ProductSpec's
/// doc comment for why that FK is deliberately loose rather than strict.
///
/// `keySlug` (not the translatable `keyEn`) is the stable identity used for
/// the per-category uniqueness constraint, mirroring how Category/Brand/
/// Product use `slug` as their stable identifier distinct from `nameEn`. This
/// lets an admin retitle "Screen Size" -> "Display Size" without it being
/// treated as a different key.
model SpecTemplateKey {
  id          String  @id @default(cuid())
  categoryId  String  @map("category_id")
  keySlug     String  @map("key_slug")
  keyEn       String  @map("key_en")
  keySo       String  @map("key_so")
  sortOrder   Int     @default(0) @map("sort_order")
  isMandatory Boolean @default(false) @map("is_mandatory")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, keySlug])
  @@index([categoryId])
  @@map("spec_template_keys")
}

model Product {
  id             String   @id @default(cuid())
  nameEn         String   @map("name_en")
  nameSo         String   @map("name_so")
  slug           String   @unique
  descriptionEn  String?  @map("description_en")
  descriptionSo  String?  @map("description_so")
  brandId        String?  @map("brand_id")
  manufacturerId String?  @map("manufacturer_id")
  /// Denormalized copy of brand.nameEn, kept in sync by two Postgres
  /// triggers (prisma/manual-sql/003_brand_name_cache_sync.sql), never
  /// written by application code. Exists solely because a GENERATED ALWAYS
  /// AS column cannot join across tables — searchVector reads this
  /// column instead of brandId. Do not treat this as a public-facing
  /// field.
  brandNameCache String?  @map("brand_name_cache")
  sku            String   @unique
  basePriceUsd   Decimal  @map("base_price_usd") @db.Decimal(10, 2)
  stockQuantity  Int      @default(0) @map("stock_quantity")
  categoryId     String   @map("category_id")
  isActive       Boolean  @default(true) @map("is_active")
  isFeatured     Boolean  @default(false) @map("is_featured")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  /// General bilingual compatibility warning that applies to the product as
  /// a whole (e.g. "Fits most USB-C phones, but check voltage before use")
  /// rather than to one specific CompatibilityAttribute row. Per-fact
  /// warnings (e.g. "5V/1A only — 2A will damage older devices") live on
  /// CompatibilityAttribute.warningEn/So instead — see that model's doc
  /// comment for how the two levels are meant to be used together (HUB-28).
  compatibilityWarningEn String? @map("compatibility_warning_en")
  compatibilityWarningSo String? @map("compatibility_warning_so")

  /// Postgres `GENERATED ALWAYS AS (...) STORED` tsvector built from name_en,
  /// name_so, description_en and brand_name_cache. Managed by raw SQL, never
  /// written by the client. See prisma/manual-sql/001_search_vector.sql
  /// (original) and prisma/manual-sql/003_brand_name_cache_sync.sql (rebuild
  /// referencing brand_name_cache instead of brand).
  searchVector Unsupported("tsvector")? @map("search_vector")

  category                Category                 @relation(fields: [categoryId], references: [id])
  brand                   Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  manufacturer            Manufacturer?            @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  suppliers               ProductSupplier[]
  images                  ProductImage[]
  specs                   ProductSpec[]
  compatibilityAttributes CompatibilityAttribute[]
  variants                ProductVariant[]
  reviews                 Review[]
  cartItems               CartItem[]
  wishlists               Wishlist[]
  orderItems              OrderItem[]
  inventoryLogs           InventoryLog[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([brandId])
  @@index([manufacturerId])
  @@map("products")
}

/// Public-facing brand catalog. slug powers /brands/[slug] browsing.
model Brand {
  id        String   @id @default(cuid())
  nameEn    String   @map("name_en")
  nameSo    String   @map("name_so")
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("brands")
}

/// Public-facing manufacturer (distinct from Brand). Starts empty for all
/// current products — no existing data distinguishes this concept today.
model Manufacturer {
  id        String   @id @default(cuid())
  nameEn    String   @map("name_en")
  nameSo    String   @map("name_so")
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("manufacturers")
}

/// Admin-only supplier identity — narrow scope per HUR-55 (identity + product
/// relation only). Full procurement/PO fields are explicitly deferred to
/// HUB-31. Never render on public routes.
model Supplier {
  id           String   @id @default(cuid())
  name         String
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products ProductSupplier[]

  @@index([isActive])
  @@map("suppliers")
}

/// Many-to-many Product <-> Supplier. Composite PK, no attributes of its own.
model ProductSupplier {
  productId  String @map("product_id")
  supplierId String @map("supplier_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
  @@index([supplierId])
  @@map("product_suppliers")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  url       String
  altEn     String? @map("alt_en")
  altSo     String? @map("alt_so")
  position  Int     @default(0)
  /// At most one row per product may have isPrimary = true, enforced by a
  /// Postgres partial unique index Prisma cannot express in schema.prisma —
  /// see prisma/manual-sql/004_product_image_primary_unique.sql (HUB-28).
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Also the natural key the seed upserts on.
  @@unique([productId, position])
  @@index([productId])
  @@map("product_images")
}

/// Per-product spec value bag. Deliberately NOT foreign-keyed to
/// SpecTemplateKey even though zero rows exist today (HUB-27 investigation)
/// and a strict FK would carry no backfill risk: a hard FK would force every
/// product spec to reference a category template row, which breaks down as
/// soon as (a) a product needs a genuine one-off spec the template doesn't
/// list, or (b) an admin edits/removes a template key and now has to decide
/// what happens to every product row that referenced it. keyEn/keySo stay
/// free text; SpecTemplateKey exists purely to pre-fill/suggest keys in the
/// future admin product-edit form (PRD §0.5/§9: business data — including
/// which specs apply — is admin-configurable, never hardcoded or over-
/// constrained by schema).
model ProductSpec {
  id        String @id @default(cuid())
  productId String @map("product_id")
  keyEn     String @map("key_en")
  keySo     String @map("key_so")
  valueEn   String @map("value_en")
  valueSo   String @map("value_so")
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specs")
}

/// A single compatibility fact about a product (HUB-28 / PRD §5.2): a
/// compatible device/model, a connector type, an OS-support level, a
/// voltage/current requirement, or a compatible consumable (e.g. a
/// replacement cartridge). One flexible table with a fixed `type` enum was
/// chosen over five separate typed tables (CompatibleDevice, ConnectorType,
/// etc.) because:
///   1. All five kinds share the exact same shape — a bilingual label plus
///      an optional per-fact warning — so typed tables would just be five
///      copies of the same three columns with no behavioural difference.
///   2. "Queryable for future 'fits your device' filtering" only needs
///      `WHERE type = 'DEVICE' AND value_slug = '...'`, which one indexed
///      table answers as well as five would.
///   3. Unlike ProductSpec, the `type` field is a closed PRD-defined
///      taxonomy (not admin-invented free text), so it's safe to model as
///      an enum without repeating HUB-27's "don't over-constrain" concern.
///
/// `valueSlug` is the stable, locale-independent identity used for matching
/// (e.g. "iphone-15", "usb-c", "android-12-plus"), mirroring the
/// Category/Brand/SpecTemplateKey `slug`/`keySlug` convention — valueEn/So
/// remain the human-readable, editable labels.
///
/// `warningEn`/`warningSo` hold a warning specific to THIS fact (e.g. "fits
/// physically but voltage mismatch will damage device"). A warning that
/// applies to the product as a whole, not to one specific fact, belongs on
/// Product.compatibilityWarningEn/So instead.
model CompatibilityAttribute {
  id        String            @id @default(cuid())
  productId String            @map("product_id")
  type      CompatibilityType
  valueSlug String            @map("value_slug")
  valueEn   String            @map("value_en")
  valueSo   String            @map("value_so")
  warningEn String?           @map("warning_en")
  warningSo String?           @map("warning_so")
  sortOrder Int               @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type, valueSlug])
  @@index([productId])
  @@index([type, valueSlug])
  @@map("compatibility_attributes")
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String  @map("product_id")
  name          String
  sku           String  @unique
  priceUsd      Decimal @map("price_usd") @db.Decimal(10, 2)
  stockQuantity Int     @default(0) @map("stock_quantity")
  attributes    Json?   @db.JsonB
  isActive      Boolean @default(true) @map("is_active")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@index([productId])
  @@map("product_variants")
}

model Review {
  id                 String   @id @default(cuid())
  productId          String   @map("product_id")
  userId             String   @map("user_id")
  rating             Int      @db.SmallInt
  title              String?
  body               String?
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  isApproved         Boolean  @default(false) @map("is_approved")
  createdAt          DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One review per customer per product.
  @@unique([productId, userId])
  @@index([productId, isApproved])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Cart and wishlist
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  /// Null for a guest cart, which is keyed by `sessionId` until sign-in.
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  quantity  Int     @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

// ---------------------------------------------------------------------------
// Orders, payments and money
// ---------------------------------------------------------------------------

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)
  minOrderUsd Decimal?   @map("min_order_usd") @db.Decimal(10, 2)
  maxUses     Int?       @map("max_uses")
  usedCount   Int        @default(0) @map("used_count")
  expiresAt   DateTime?  @map("expires_at")
  isActive    Boolean    @default(true) @map("is_active")

  orders Order[]

  @@map("coupons")
}

model Order {
  id     String      @id @default(cuid())
  userId String?     @map("user_id")
  status OrderStatus @default(PLACED)

  subtotalUsd Decimal @map("subtotal_usd") @db.Decimal(10, 2)
  discountUsd Decimal @default(0) @map("discount_usd") @db.Decimal(10, 2)
  taxUsd      Decimal @default(0) @map("tax_usd") @db.Decimal(10, 2)
  totalUsd    Decimal @map("total_usd") @db.Decimal(10, 2)

  /// Currency the customer is actually charged in, and the amount in that
  /// currency. `fxRate`/`fxRateAt` pin the rate used at checkout so a later
  /// rate move never changes a placed order.
  chargeCurrency Currency  @map("charge_currency")
  chargeAmount   Decimal   @map("charge_amount") @db.Decimal(12, 2)
  fxRate         Decimal?  @map("fx_rate") @db.Decimal(14, 6)
  fxRateAt       DateTime? @map("fx_rate_at")

  shippingAddressId String?        @map("shipping_address_id")
  couponId          String?        @map("coupon_id")
  paymentMethod     PaymentMethod? @map("payment_method")
  paymentStatus     PaymentStatus? @default(PENDING) @map("payment_status")
  isWhatsappOrder   Boolean        @default(false) @map("is_whatsapp_order")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  /// Carrier tracking number, set by admin operations once a shipment is
  /// created (HUB-46, out of scope for this issue). Nullable until then;
  /// only ever displayed on the order-detail/tracking pages when present.
  trackingNumber String? @map("tracking_number")

  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddress  Address?              @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  coupon           Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  whatsappSessions WhatsappSession[]
  statusHistory    OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  /// Nullable so deleting a product never destroys order history; the snapshot
  /// columns keep the line item readable on their own.
  productId String? @map("product_id")
  variantId String? @map("variant_id")
  quantity  Int

  unitPriceUsd   Decimal @map("unit_price_usd") @db.Decimal(10, 2)
  nameSnapshotEn String  @map("name_snapshot_en")
  nameSnapshotSo String  @map("name_snapshot_so")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Append-only history of an order's `status` transitions (HUB-39, U14).
/// One row is written per transition — including the initial row created at
/// checkout time (see src/lib/api/checkout.ts's placeOrder(), which inserts
/// the PLACED row inside the same transaction as the Order itself) — so the
/// order-tracking timeline (Placed -> Processing -> Shipped -> Delivered, or
/// -> Cancelled) can render exact per-stage timestamps.
///
/// Append-only by application convention only, mirroring how Order/OrderItem
/// are treated as immutable once created: there is deliberately no
/// update/delete path in application code. Unlike AuditLog, this table has
/// no DB-level rejecting trigger enforcing that for MVP — the audit trail of
/// *who* changed an order's status already lives in AuditLog's
/// `order.status_change` action (with actorId), so this table only needs to
/// answer "what was the status, and when" for the customer-facing timeline;
/// adding a trigger here would duplicate enforcement without adding new
/// information. Revisit if this table's write path is ever exposed beyond
/// the single trusted admin status-change flow (HUB-46).
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id      String         @id @default(cuid())
  orderId String         @map("order_id")
  gateway PaymentGateway
  method  PaymentMethod

  /// Our idempotency key sent to the gateway; unique per gateway.
  gatewayReference     String  @map("gateway_reference")
  gatewayTransactionId String? @map("gateway_transaction_id")

  amountUsd      Decimal  @map("amount_usd") @db.Decimal(10, 2)
  chargeAmount   Decimal  @map("charge_amount") @db.Decimal(12, 2)
  chargeCurrency Currency @map("charge_currency")

  status          PaymentStatus @default(PENDING)
  callbackPayload Json?         @map("callback_payload") @db.JsonB
  lastPolledAt    DateTime?     @map("last_polled_at")
  pollAttempts    Int           @default(0) @map("poll_attempts")
  createdAt       DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([gateway, gatewayReference])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model FxRate {
  id        String   @id @default(cuid())
  base      FxBase   @default(USD)
  quote     FxQuote  @default(KES)
  rate      Decimal  @db.Decimal(14, 6)
  spreadPct Decimal  @map("spread_pct") @db.Decimal(5, 3)
  source    String
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@index([base, quote, fetchedAt])
  @@map("fx_rates")
}

// ---------------------------------------------------------------------------
// WhatsApp commerce and stock auditing
// ---------------------------------------------------------------------------

model WhatsappSession {
  id            String   @id @default(cuid())
  waPhoneId     String   @map("wa_phone_id")
  fromPhone     String   @map("from_phone")
  userId        String?  @map("user_id")
  orderId       String?  @map("order_id")
  state         String
  context       Json?    @db.JsonB
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([fromPhone])
  @@index([userId])
  @@map("whatsapp_sessions")
}

model InventoryLog {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  /// Signed change: negative on sale, positive on restock.
  delta         Int
  reason        String
  /// Optional pointer to the entity that caused this adjustment (e.g. an
  /// order line item on sale, a purchase order on receiving). Free-text
  /// type + id pair, mirroring AuditLog's entityType/entityId — not a FK,
  /// since the referenced entity type varies by reason.
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  user    User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_logs")
}

/// Append-only audit trail for sensitive actions (admin catalog/price changes,
/// order status changes, refunds, warranty overrides, inventory adjustments,
/// credential/role changes). Written exclusively through the transactional
/// helper in src/lib/audit.ts — there is deliberately no update/delete path in
/// application code, and prisma/migrations/manual/002_audit_log_append_only.sql
/// enforces the same rule at the database level with a rejecting trigger.
///
/// `action` is a free string rather than an enum, namespaced `<entity>.<verb>`
/// (e.g. `order.status_change`, `warranty.override`) — an enum would force
/// every unrelated future feature's migration to also touch this table.
model AuditLog {
  id      String  @id @default(cuid())
  /// Null only for actions with no human actor; every action currently listed
  /// in this issue's policy is admin-triggered, so this is nullable for
  /// forward compatibility, not because a real case needs it yet.
  actorId String? @map("actor_id")
  action  String

  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  before Json?   @db.JsonB
  after  Json?   @db.JsonB
  reason String?

  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
